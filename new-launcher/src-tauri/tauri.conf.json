{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "new-launcher",
  "version": "0.1.0",
  "identifier": "com.pc.new-launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "new-launcher",
        "width": 1200,
        "height": 700,
        "closable": false,
        "maximizable": false,
        "minimizable": false,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "draggable-window",
          "windows": ["*"],
          "permissions": ["core:window:allow-start-dragging"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
